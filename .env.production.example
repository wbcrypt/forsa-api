# ─── FORSA OS — PRODUCTION ENVIRONMENT ───────────────────────────────────────
# Copy to .env on your production server and fill all values

NODE_ENV=production
PORT=3000
APP_URL=https://api.forsa.tn
FRONTEND_URL=https://forsa.tn
STUDENT_PORTAL_URL=https://student.forsa.tn
API_PREFIX=api/v1

# ─── DATABASE ────────────────────────────────────────────────────────────────
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=forsa_os_prod
DB_APP_USER=forsa_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_READONLY_USER=forsa_readonly
DB_READONLY_PASSWORD=CHANGE_ME_READONLY_PASSWORD
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_PASSWORD
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── JWT SECRETS — generate with: openssl rand -hex 64 ───────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_DIFFERENT
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── SESSION ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=forsa_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# ─── ENCRYPTION — generate with: openssl rand -hex 32 ────────────────────────
PII_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX
MFA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_DIFFERENT
CURRENT_PII_KEY_VERSION=pii_v1

# ─── OBJECT STORAGE (S3-compatible) ──────────────────────────────────────────
S3_ENDPOINT=https://s3.your-provider.com
S3_REGION=eu-west-1
S3_BUCKET_NAME=forsa-documents-prod
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_SIGNED_URL_EXPIRY_SECONDS=300
S3_FORCE_PATH_STYLE=false

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=true
REDIS_KEY_PREFIX=forsa:

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@forsa.tn
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=FORSA
SMTP_FROM_EMAIL=noreply@forsa.tn

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME
AI_DEMO_MODE=false

# ─── SECURITY ────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://forsa.tn,https://www.forsa.tn,https://student.forsa.tn,https://guarantor.forsa.tn,https://university.forsa.tn,https://partner.forsa.tn,https://finance.forsa.tn,https://admin.forsa.tn
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL_SECONDS=60
LOGIN_THROTTLE_LIMIT=5

# ─── BOOTSTRAP (first run only) ──────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@forsa.tn
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BOOTSTRAP_TENANT_NAME=FORSA Tunisia
BOOTSTRAP_TENANT_SLUG=forsa-tn
BOOTSTRAP_TENANT_COUNTRY=TN
BOOTSTRAP_TENANT_CURRENCY=TND

# ─── FEATURES ────────────────────────────────────────────────────────────────
FEATURE_MFA_REQUIRED=true
FEATURE_WHATSAPP_NOTIFICATIONS=false
FEATURE_AI_DOCUMENT_VERIFICATION=false
FEATURE_STUDENT_PORTAL=true
FEATURE_PARTNER_PORTAL=true

# ─── KONNECT PAYMENT GATEWAY ─────────────────────────────────────────────────
# Get credentials from https://konnect.network
KONNECT_API_KEY=your-konnect-api-key
KONNECT_WALLET_ID=your-wallet-id
KONNECT_BASE_URL=https://api.konnect.network/api/v2
KONNECT_WEBHOOK_SECRET=your-webhook-secret
KONNECT_APP_NAME=FORSA
KONNECT_RETURN_URL=https://student.forsa.tn/payments
# For testing: https://api.preprod.konnect.network/api/v2
