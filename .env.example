# =============================================================================
# FORSA OS — Environment Variables
# Copy this file to .env and fill in all values before starting the application
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_NAME="FORSA OS"
APP_URL=https://os.forsa.tn
FRONTEND_URL=https://os.forsa.tn
# Phase 3.5 finding: membership.service.ts's set-password email link falls
# back to a hardcoded https://student.forsa.tn if this is unset — fine for
# the actual production domain, but silently WRONG for any other
# environment (staging, a renamed domain, local dev). Always set this
# explicitly rather than relying on the fallback.
STUDENT_PORTAL_URL=https://student.forsa.tn
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forsa_os
DB_APP_USER=forsa_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD_APP
DB_READONLY_USER=forsa_readonly
DB_READONLY_PASSWORD=CHANGE_ME_STRONG_PASSWORD_RO
DB_MIGRATION_USER=forsa_migration
DB_MIGRATION_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIG
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=2
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# JWT & SESSION
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTE_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_COOKIE_NAME=forsa_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_HTTPONLY=true

# -----------------------------------------------------------------------------
# ENCRYPTION — PII & Sensitive Fields
# Application-layer AES-256-GCM encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
PII_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
PII_ENCRYPTION_IV_LENGTH=16
MFA_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_32_BYTE_HEX_KEY
CURRENT_PII_KEY_VERSION=pii_v1
CURRENT_MFA_KEY_VERSION=mfa_v1

# -----------------------------------------------------------------------------
# S3-COMPATIBLE DOCUMENT STORAGE
# Works with AWS S3, Cloudflare R2, MinIO
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=eu-west-1
S3_BUCKET_NAME=forsa-os-documents
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_SIGNED_URL_EXPIRY_SECONDS=300
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# REDIS — Queue & Rate Limiting
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=true
REDIS_KEY_PREFIX=forsa:

# -----------------------------------------------------------------------------
# MFA
# -----------------------------------------------------------------------------
MFA_ISSUER=FORSA OS
MFA_TOTP_WINDOW=1
MFA_SMS_PROVIDER=twilio

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@forsa.tn
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=FORSA OS
SMTP_FROM_EMAIL=noreply@forsa.tn

# -----------------------------------------------------------------------------
# SMS (future: WhatsApp via Twilio or similar)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+21600000000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL_SECONDS=900
LOGIN_THROTTLE_LIMIT=5
DOCUMENT_THROTTLE_TTL_SECONDS=60
DOCUMENT_THROTTLE_LIMIT=20

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
CORS_ORIGINS=https://os.forsa.tn
HELMET_CSP=true

# -----------------------------------------------------------------------------
# AUDIT & LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=2555
SECURITY_LOG_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# BOOTSTRAP ADMIN — used ONLY during first-run seed, then must be removed
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@forsa.tn
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY_AFTER_FIRST_LOGIN
BOOTSTRAP_TENANT_NAME=FORSA Tunisia
BOOTSTRAP_TENANT_SLUG=forsa-tn
BOOTSTRAP_TENANT_COUNTRY=TN
BOOTSTRAP_TENANT_CURRENCY=TND

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_MFA_REQUIRED=true
FEATURE_WHATSAPP_NOTIFICATIONS=false
FEATURE_AI_DOCUMENT_VERIFICATION=false
FEATURE_STUDENT_PORTAL=false
FEATURE_PARTNER_PORTAL=false
